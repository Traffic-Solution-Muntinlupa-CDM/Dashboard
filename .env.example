# Copy to .env.local (git-ignored) and edit.
#
# Base URL of the Raspberry Pi controller, as seen by the Vite dev/preview
# proxy. While the prototype is unavailable this points at the mock controller
# started by `npm run mock:pi`. On the Pi's network, set it to e.g.
#   VITE_PI_URL=http://192.168.1.42:8080
VITE_PI_URL=http://127.0.0.1:8080

# Leave false for the normal setup: the browser calls /pi and Vite proxies it,
# so the Pi needs no CORS headers and the page stays same-origin (this also
# keeps PUT /config working). Only set true when the dashboard is served from an
# origin that already reaches the controller directly, e.g. the build is hosted
# on the Pi itself.
VITE_PI_DIRECT=false

# Weather: the dashboard reads Open-Meteo directly, with the same coordinates
# and refresh window as deployed/config/cv.yaml. Defaults are the Muntinlupa
# intersection; only change these if the site moves.
VITE_WEATHER_LAT=14.4081
VITE_WEATHER_LON=121.0415

# Operator sign-in gate. Checked in the browser only — demo UX, not security:
# the controller's operator endpoints are unauthenticated by design.
VITE_OPERATOR_PASSWORD=andar-demo
